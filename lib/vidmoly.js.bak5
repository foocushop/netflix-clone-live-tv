/**
 * lib/vidmoly.js - Passerelle Vidmoly Cloud & Stream Resolver pour ZIFLIX
 * Gère :
 * - Rotation dynamique multi-comptes avec auto-génération à la volée (via lib/vidmoly-accounts)
 * - Tampon local préalable anti-coupure (/tmp/vidmoly_buffer) garantissant 100% de la durée des épisodes
 * - Remote Upload (aspiration haute vitesse depuis le SSD local de notre serveur)
 * - Nettoyage automatique du stockage tampon local après transfert
 * - Résolution transparente du flux HLS (.m3u8) sans aucune pub (0 requête API consommée)
 */

const fs = require('fs');
const path = require('path');
const https = require('https');
const http = require('http');
const { execSync } = require('child_process');
let vidmolyAccounts;
try {
  vidmolyAccounts = require('./vidmoly-accounts');
} catch (e) {
  vidmolyAccounts = require('/var/www/netflix-clone/lib/vidmoly-accounts');
}

let SocksProxyAgent = null;
try {
  SocksProxyAgent = require('socks-proxy-agent').SocksProxyAgent;
} catch (e) {
  try {
    SocksProxyAgent = require('/var/www/netflix-clone/node_modules/socks-proxy-agent').SocksProxyAgent;
  } catch (e2) {}
}
const warpAgent = SocksProxyAgent ? new SocksProxyAgent(process.env.XTREAM_WARP_URL || 'socks5h://127.0.0.1:40000') : null;
const torAgent = SocksProxyAgent ? new SocksProxyAgent(process.env.XTREAM_TOR_URL || 'socks5h://127.0.0.1:9050') : null;
const resolvedPlaylistsCache = new Map();
const resolvedStreamsCache = new Map();

const DATA_DIR = path.join(__dirname, '..', 'data');
const STATE_FILE = path.join(DATA_DIR, 'vidmoly_state.json');
const FOLDERS_FILE = path.join(DATA_DIR, 'vidmoly_folders.json');
const EPISODES_FILE = path.join(DATA_DIR, 'vidmoly_episodes.json');
const QUEUE_FILE = path.join(DATA_DIR, 'vidmoly_queue.json');
const BUFFER_DIR = '/tmp/vidmoly_buffer';

const CONFIG = {
  apiBase: 'https://vidmoly.me/api'
};

// Assure l'existence des répertoires et fichiers
function ensureStorage() {
  if (!fs.existsSync(DATA_DIR)) fs.mkdirSync(DATA_DIR, { recursive: true });
  if (!fs.existsSync(FOLDERS_FILE)) fs.writeFileSync(FOLDERS_FILE, '{}', 'utf8');
  if (!fs.existsSync(EPISODES_FILE)) fs.writeFileSync(EPISODES_FILE, '{}', 'utf8');
  if (!fs.existsSync(QUEUE_FILE)) fs.writeFileSync(QUEUE_FILE, '[]', 'utf8');
  if (!fs.existsSync(BUFFER_DIR)) fs.mkdirSync(BUFFER_DIR, { recursive: true });
}

function getState() {
  ensureStorage();
  const quotaInfo = vidmolyAccounts.getTotalQuota();
  return {
    accountsCount: quotaInfo.accountsCount,
    totalRemainingRequests: quotaInfo.totalRemainingRequests,
    remainingRequests: quotaInfo.totalRemainingRequests,
    totalLimit: (quotaInfo.accountsCount || 20) * 50,
    accounts: quotaInfo.accounts,
    storageLeft: 16106127360000,
    storageUsed: 0
  };
}

function canMakeApiCall() {
  const quota = vidmolyAccounts.getTotalQuota();
  return quota.totalRemainingRequests > 0;
}

// Effectue un appel HTTP GET pour Vidmoly (Direct en priorité pour les embeds, avec repli WARP si nécessaire)
async function fetchHttpWarp(url, headers = {}) {
  // Priorité 1 : Connexion directe (vidmoly.org répond 200 OK en direct sur notre IP, mais bloque WARP avec du 404)
  try {
    const directRes = await fetchHttp(url, headers);
    if (directRes && (directRes.statusCode === 200 || directRes.statusCode === 206) && directRes.text && directRes.text.length > 500) {
      return directRes;
    }
  } catch (directErr) {}

  // Priorité 2 : Repli sur agent WARP / Tor si direct a échoué
  return new Promise((resolve, reject) => {
    const isHttps = url.startsWith('https:');
    const client = isHttps ? https : http;
    const reqOptions = {
      headers: {
        'User-Agent': 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/122.0.0.0 Safari/537.36',
        'Referer': 'https://vidmoly.org/',
        ...headers
      },
      timeout: 15000
    };
    if (warpAgent) {
      reqOptions.agent = warpAgent;
    }
    const req = client.get(url, reqOptions, (res) => {
      if (res.statusCode >= 300 && res.statusCode < 400 && res.headers.location) {
        const nextUrl = res.headers.location.startsWith('http') ? res.headers.location : new URL(res.headers.location, url).href;
        return resolve(fetchHttpWarp(nextUrl, headers));
      }
      let chunks = [];
      res.on('data', chunk => chunks.push(chunk));
      res.on('end', () => {
        const buf = Buffer.concat(chunks);
        resolve({
          statusCode: res.statusCode,
          headers: res.headers,
          text: buf.toString('utf8'),
          body: buf
        });
      });
    });
    req.on('error', (err) => {
      reject(err);
    });
    req.on('timeout', () => { req.destroy(); reject(new Error('HTTP timeout: ' + url)); });
  });
}

function fetchHttp(url, headers = {}) {
  return new Promise((resolve, reject) => {
    const isHttps = url.startsWith('https:');
    const client = isHttps ? https : http;
    const req = client.get(url, {
      headers: {
        'User-Agent': 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/122.0.0.0 Safari/537.36',
        'Referer': 'https://vidmoly.org/',
        ...headers
      },
      timeout: 15000
    }, (res) => {
      if (res.statusCode >= 300 && res.statusCode < 400 && res.headers.location) {
        const nextUrl = res.headers.location.startsWith('http') ? res.headers.location : new URL(res.headers.location, url).href;
        return resolve(fetchHttp(nextUrl, headers));
      }
      let chunks = [];
      res.on('data', chunk => chunks.push(chunk));
      res.on('end', () => {
        const buf = Buffer.concat(chunks);
        resolve({
          statusCode: res.statusCode,
          headers: res.headers,
          text: buf.toString('utf8'),
          body: buf
        });
      });
    });
    req.on('error', reject);
    req.on('timeout', () => { req.destroy(); reject(new Error('HTTP timeout: ' + url)); });
  });
}

// 1. Informations du compte (multi-comptes)
async function getAccountInfo(force = false) {
  return getState();
}

// 2. Gestion et cache des dossiers dans Vidmoly
function getCachedFolders() {
  ensureStorage();
  try {
    return JSON.parse(fs.readFileSync(FOLDERS_FILE, 'utf8'));
  } catch (e) {
    return {};
  }
}

async function getOrCreateFolder(seriesTitle, seasonNum) {
  const folders = getCachedFolders();
  const seriesSlug = seriesTitle.toLowerCase().replace(/[^a-z0-9]/g, '_').slice(0, 40);
  const cacheKey = seasonNum ? `${seriesSlug}_s${seasonNum}` : seriesSlug;

  if (folders[cacheKey]) {
    return folders[cacheKey]; // 0 requête API consommée !
  }

  const apiKey = vidmolyAccounts.getActiveApiKey();
  try {
    const folderName = seasonNum 
      ? `${seriesTitle} - S${String(seasonNum).padStart(2, '0')}`
      : seriesTitle;
    
    const url = `${CONFIG.apiBase}/folder/create?key=${apiKey}&name=${encodeURIComponent(folderName)}&parent_id=0`;
    const res = await fetchHttp(url);
    vidmolyAccounts.incrementAccountQuota(apiKey);
    const json = JSON.parse(res.text);
    if (json.status === 200 && json.result && json.result.fld_id) {
      folders[cacheKey] = json.result.fld_id;
      fs.writeFileSync(FOLDERS_FILE, JSON.stringify(folders, null, 2), 'utf8');
      return json.result.fld_id;
    }
  } catch (e) {
    console.error('[Vidmoly] Erreur création dossier:', e.message);
  }
  return 0;
}

// 3. Téléversement à distance (Remote Upload)
function getEpisodesMap() {
  ensureStorage();
  try {
    return JSON.parse(fs.readFileSync(EPISODES_FILE, 'utf8'));
  } catch (e) {
    return {};
  }
}

function saveEpisodeEntry(epId, entry) {
  const map = getEpisodesMap();
  const prev = map[String(epId)] || {};
  const merged = { ...prev, episodeId: String(epId), ...entry, updatedAt: Date.now() };

  const code = merged.fileCode || entry.fileCode;
  if (code) {
    merged.fileUrl = `https://vidmoly.org/${code}.html`;
    merged.embedUrl = `https://vidmoly.org/embed-${code}.html`;
  } else {
    if (merged.embedUrl) {
      merged.embedUrl = merged.embedUrl.replace(/vidmoly\.(me|biz|net|to)/g, 'vidmoly.org').replace(/embed-embed-/g, 'embed-');
    }
    if (merged.fileUrl) {
      merged.fileUrl = merged.fileUrl.replace(/vidmoly\.(me|biz|net|to)/g, 'vidmoly.org');
    }
  }

  map[String(epId)] = merged;
  fs.writeFileSync(EPISODES_FILE, JSON.stringify(map, null, 2), 'utf8');
  return map[String(epId)];
}

// ================= TAMPON LOCAL ANTI-COUPURE =================
// Télécharge l'épisode complet sur le SSD local et vérifie sa durée intégrale avec ffprobe

function resolveFoxBleuRedirect(url) {
  return new Promise((resolve) => {
    try {
      const parsed = new URL(url);
      const client = parsed.protocol === 'https:' ? https : http;
      const isFoxBleu = url.includes('foxbleu.org') || url.includes('192.142.27.91');
      const agent = (isFoxBleu && torAgent) ? torAgent : undefined;
      const req = client.get(url, {
        agent,
        headers: {
          'User-Agent': 'VLC/3.0.18 LibVLC/3.0.18',
          'Range': 'bytes=0-100'
        },
        timeout: 10000
      }, (res) => {
        if (res.statusCode >= 300 && res.statusCode < 400 && res.headers.location) {
          const loc = res.headers.location;
          const nextUrl = loc.startsWith('http') ? loc : new URL(loc, url).href;
          resolve(nextUrl);
        } else {
          resolve(url);
        }
      });
      req.on('error', () => resolve(url));
      req.setTimeout(8000, () => { req.destroy(); resolve(url); });
    } catch {
      resolve(url);
    }
  });
}

function downloadEpisodeWithAria2(directUrl, targetFilePath) {
  const dir = path.dirname(targetFilePath);
  const fileName = path.basename(targetFilePath);
  const t0 = Date.now();

  const args = [
    '-x', '16',
    '-s', '16',
    '-k', '1M',
    '--file-allocation=none',
    '--summary-interval=2',
    '--user-agent=VLC/3.0.18 LibVLC/3.0.18',
    '--allow-overwrite=true',
    '--auto-file-renaming=false',
    '--max-connection-per-server=16',
    '--min-split-size=1M',
    '--connect-timeout=15',
    '--timeout=30',
    '--max-tries=5',
    '--retry-wait=2',
    '-d', dir,
    '-o', fileName,
    directUrl
  ];

  return new Promise((resolve, reject) => {
    const { spawn } = require('child_process');
    const child = spawn('aria2c', args);
    let lastProgressTime = Date.now();

    child.stdout.on('data', (d) => {
      lastProgressTime = Date.now();
      const str = d.toString();
      const m = str.match(/\[#\w+\s+([\d.]+\w+)\/([\d.]+\w+)\(([\d.]+)%\).*?DL:([\d.]+\w+)/);
      if (m) {
        console.log(`[Vidmoly Buffer Turbo] ${m[1]}/${m[2]} (${m[3]}%) - Vitesse: ${m[4]}/s`);
      }
    });

    const watchdog = setInterval(() => {
      if (Date.now() - lastProgressTime > 45000) {
        clearInterval(watchdog);
        try { child.kill('SIGKILL'); } catch (e) {}
        reject(new Error('Aria2c bloqué sans progression pendant 45s'));
      }
    }, 5000);

    child.on('close', (code) => {
      clearInterval(watchdog);
      const elapsed = ((Date.now() - t0) / 1000).toFixed(1);
      if (code === 0 && fs.existsSync(targetFilePath)) {
        const sizeMb = (fs.statSync(targetFilePath).size / (1024 * 1024)).toFixed(1);
        const speed = (sizeMb / elapsed).toFixed(1);
        console.log(`[Vidmoly Buffer Turbo] ✅ Téléchargement achevé : ${sizeMb} MB en ${elapsed}s (${speed} MB/s)`);
        resolve(targetFilePath);
      } else {
        reject(new Error(`Aria2c code ${code}`));
      }
    });

    child.on('error', (err) => {
      clearInterval(watchdog);
      reject(err);
    });
  });
}


function getRemoteFileSize(urlStr) {
  return new Promise((resolve) => {
    try {
      const parsed = new URL(urlStr);
      const client = parsed.protocol === 'https:' ? https : http;
      const req = client.request(urlStr, {
        method: 'GET',
        headers: { 'Range': 'bytes=0-0', 'User-Agent': 'VLC/3.0.18 LibVLC/3.0.18' },
        timeout: 8000
      }, (res) => {
        res.destroy();
        if (res.statusCode === 206 || res.statusCode === 200) {
          const cr = res.headers['content-range'];
          if (cr) {
            const m = cr.match(/\/(\d+)$/);
            if (m) return resolve(parseInt(m[1], 10));
          }
          const cl = res.headers['content-length'];
          if (cl) return resolve(parseInt(cl, 10));
        }
        resolve(0);
      });
      req.on('error', () => resolve(0));
      req.setTimeout(8000, () => { req.destroy(); resolve(0); });
      req.end();
    } catch {
      resolve(0);
    }
  });
}

function parseUnitToMb(str) {
  if (!str) return 0;
  const clean = str.trim().toUpperCase();
  const num = parseFloat(clean);
  if (isNaN(num)) return 0;
  if (clean.includes('GIB') || clean.includes('GB')) return num * 1024;
  if (clean.includes('MIB') || clean.includes('MB')) return num;
  if (clean.includes('KIB') || clean.includes('KB')) return num / 1024;
  if (clean.includes('B')) return num / (1024 * 1024);
  return num;
}

function downloadWithAria2(directUrl, targetFilePath, epId, remoteTotalBytes) {
  const dir = path.dirname(targetFilePath);
  const fileName = path.basename(targetFilePath);
  const { spawn } = require('child_process');

  const args = [
    '-x', '16',
    '-s', '16',
    '-k', '1M',
    '--file-allocation=none',
    '--summary-interval=1',
    '--user-agent=VLC/3.0.18 LibVLC/3.0.18',
    '--allow-overwrite=true',
    '--auto-file-renaming=false',
    '--max-connection-per-server=16',
    '--min-split-size=1M',
    '--stream-piece-selector=inorder',
    '--connect-timeout=15',
    '--timeout=30',
    '--max-tries=5',
    '--retry-wait=2',
    '-d', dir,
    '-o', fileName,
    directUrl
  ];

  return new Promise((resolve, reject) => {
    const child = spawn('aria2c', args);
    let lastProgressTime = Date.now();

    const handleData = (data) => {
      const text = data.toString();
      const match = text.match(/\[#\w+\s+([\d.]+\w+)\/([\d.]+\w+)\(([\d.]+)%\).*?DL:([\d.]+\w+)/);
      if (match) {
        lastProgressTime = Date.now();
        const currentMB = parseUnitToMb(match[1]).toFixed(1);
        const totalMB = parseUnitToMb(match[2]).toFixed(1);
        const rawPercent = parseFloat(match[3]) || 0;
        const safePercent = Math.min(100, Math.max(0, Math.round(rawPercent)));
        const speedMB = (parseUnitToMb(match[4]) || 0).toFixed(1);

        saveEpisodeEntry(epId, {
          status: 'downloading',
          statusMessage: `Téléchargement FoxBleu (${safePercent}% - ${speedMB} Mo/s)`,
          downloadProgress: { currentMB, totalMB, percent: safePercent, speedMB }
        });
      }
    };

    child.stdout.on('data', handleData);
    child.stderr.on('data', handleData);

    const watchdog = setInterval(() => {
      if (Date.now() - lastProgressTime > 45000) {
        clearInterval(watchdog);
        try { child.kill('SIGKILL'); } catch (e) {}
        reject(new Error('Aria2c bloqué sans progression (Watchdog 45s)'));
      }
    }, 5000);

    child.on('close', (code) => {
      clearInterval(watchdog);
      if (code === 0) {
        resolve();
      } else {
        reject(new Error(`Aria2c exited with code ${code}`));
      }
    });

    child.on('error', (err) => {
      clearInterval(watchdog);
      reject(err);
    });
  });
}

function downloadWithProgress(url, targetFilePath, remoteTotalBytes, epId) {
  return new Promise((resolve, reject) => {
    const { spawn } = require('child_process');
    const child = spawn('curl', [
      '-s', '-L',
      '-A', 'VLC/3.0.18 LibVLC/3.0.18',
      '--tcp-nodelay',
      '--keepalive-time', '2',
      '--max-time', '180',
      '-C', '-',
      '-o', targetFilePath,
      url
    ]);

    let lastBytes = fs.existsSync(targetFilePath) ? fs.statSync(targetFilePath).size : 0;
    let lastTime = Date.now();

    const timer = setInterval(() => {
      try {
        if (!fs.existsSync(targetFilePath)) return;
        const currentBytes = fs.statSync(targetFilePath).size;
        const now = Date.now();
        const dt = (now - lastTime) / 1000;
        if (dt >= 0.8) {
          const bytesDiff = Math.max(0, currentBytes - lastBytes);
          const speedMB = (bytesDiff / dt / 1024 / 1024).toFixed(1);
          const currentMB = (currentBytes / 1024 / 1024).toFixed(1);
          const totalMB = remoteTotalBytes > 0 ? (remoteTotalBytes / 1024 / 1024).toFixed(1) : '?';
          const percent = remoteTotalBytes > 0 ? Math.min(100, Math.round((currentBytes / remoteTotalBytes) * 100)) : 0;

          saveEpisodeEntry(epId, {
            status: 'downloading',
            statusMessage: `Téléchargement FoxBleu (${percent}% - ${speedMB} Mo/s)`,
            downloadProgress: { currentMB, totalMB, percent, speedMB }
          });

          lastBytes = currentBytes;
          lastTime = now;
        }
      } catch (e) {}
    }, 1000);

    child.on('error', (err) => {
      clearInterval(timer);
      reject(err);
    });

    child.on('close', (code) => {
      clearInterval(timer);
      resolve(code);
    });
  });
}

async function bufferEpisodeLocally(episodeId, ext = 'mkv') {
  ensureStorage();
  const epId = String(episodeId);
  const localFile = path.join(BUFFER_DIR, `${epId}.${ext}`);

  if (!fs.existsSync(BUFFER_DIR)) fs.mkdirSync(BUFFER_DIR, { recursive: true });

  const foxbleuUrl = `http://foxbleu.org:80/series/josealbino/21321/${epId}.${ext}`;
  console.log(`[Vidmoly Buffer] Résolution du lien direct CDN pour l'épisode ${epId}...`);

  let directUrl = await resolveFoxBleuRedirect(foxbleuUrl);
  const isDirectCdn = directUrl && directUrl !== foxbleuUrl && !directUrl.includes('foxbleu.org');

  let remoteTotalBytes = 0;
  if (isDirectCdn) {
    remoteTotalBytes = await getRemoteFileSize(directUrl);
    if (remoteTotalBytes > 0) {
      console.log(`[Vidmoly Buffer] Taille attendue du fichier sur CDN : ${(remoteTotalBytes / 1024 / 1024).toFixed(1)} MB`);
    }
  }

  // 1. Si le fichier existe déjà et est complet
  if (fs.existsSync(localFile)) {
    const stat = fs.statSync(localFile);
    const isComplete = remoteTotalBytes > 0 
      ? stat.size >= remoteTotalBytes * 0.995 
      : stat.size > 500 * 1024 * 1024;

    if (isComplete) {
      console.log(`[Vidmoly Buffer] Épisode ${epId} déjà complet en tampon local (${(stat.size/1024/1024).toFixed(1)} MB).`);
      saveEpisodeEntry(epId, {
        status: 'downloading',
        statusMessage: 'Téléchargement FoxBleu terminé (100%)',
        downloadProgress: { currentMB: (stat.size/1024/1024).toFixed(1), totalMB: (stat.size/1024/1024).toFixed(1), percent: 100, speedMB: 0 }
      });
      return localFile;
    }
  }

  saveEpisodeEntry(epId, {
    status: 'downloading',
    statusMessage: 'Téléchargement FoxBleu en cours (Aria2c 16 canaux)...',
    downloadProgress: { currentMB: '0', totalMB: remoteTotalBytes > 0 ? (remoteTotalBytes/1024/1024).toFixed(1) : '?', percent: 0, speedMB: '0' }
  });

  // 2. Téléchargement Turbo Multi-Connexions 16 canaux avec Aria2c
  try {
    console.log(`[Vidmoly Buffer] Démarrage Aria2c 16 canaux pour épisode ${epId}...`);
    await downloadWithAria2(directUrl, localFile, epId, remoteTotalBytes);
  } catch (ariaErr) {
    console.warn(`[Vidmoly Buffer Warn] Aria2c non complété (${ariaErr.message}), bascule sur reprise curl...`);
    // Fallback curl résilient
    let passes = 0;
    while (passes < 8) {
      passes++;
      let currentSize = fs.existsSync(localFile) ? fs.statSync(localFile).size : 0;
      if (remoteTotalBytes > 0 && currentSize >= remoteTotalBytes * 0.995) break;

      const freshCdnUrl = await resolveFoxBleuRedirect(foxbleuUrl);
      try {
        await downloadWithProgress(freshCdnUrl, localFile, remoteTotalBytes, epId);
      } catch(e) {}
    }
  }

  if (fs.existsSync(localFile)) {
    const finalStat = fs.statSync(localFile);
    const isComplete = remoteTotalBytes > 0 
      ? finalStat.size >= remoteTotalBytes * 0.95 
      : finalStat.size > 200 * 1024 * 1024;

    if (isComplete) {
      console.log(`[Vidmoly Buffer] ✅ Épisode ${epId} téléchargé avec succès (${(finalStat.size/1024/1024).toFixed(1)} MB) !`);
      saveEpisodeEntry(epId, {
        status: 'downloading',
        statusMessage: 'Téléchargement FoxBleu terminé (100%)',
        downloadProgress: { currentMB: (finalStat.size/1024/1024).toFixed(1), totalMB: (finalStat.size/1024/1024).toFixed(1), percent: 100, speedMB: 0 }
      });
      return localFile;
    }
  }

  throw new Error(`Échec du téléchargement tampon local pour l'épisode ${epId}`);
}

// ================= GESTIONNAIRE DE FILE D'ATTENTE SÉQUENTIELLE (1 PAR 1) =================
let isProcessingQueue = false;
let activeUploadJob = null;
let activeUploadTimeout = null;

function getQueue() {
  ensureStorage();
  try {
    return JSON.parse(fs.readFileSync(QUEUE_FILE, 'utf8'));
  } catch (e) {
    return [];
  }
}

function saveQueue(queue) {
  fs.writeFileSync(QUEUE_FILE, JSON.stringify(queue, null, 2), 'utf8');
}

function addToQueue(jobs, allowDuplicates = false) {
  const queue = getQueue();
  const jobArray = Array.isArray(jobs) ? jobs : [jobs];
  for (const j of jobArray) {
    const existingIndex = queue.findIndex(q => String(q.episodeId) === String(j.episodeId));
    if (existingIndex !== -1) {
      if (allowDuplicates) {
        queue.splice(existingIndex, 1);
        queue.push({ ...j, queuedAt: Date.now() });
      }
    } else {
      queue.push({ ...j, queuedAt: Date.now() });
    }

    // Toujours marquer chaque épisode en file d'attente immédiatement
    saveEpisodeEntry(j.episodeId, {
      status: 'queued',
      statusMessage: "En file d'attente",
      seriesTitle: j.seriesTitle,
      season: j.season,
      episode: j.episode,
      title: j.title,
      downloadProgress: null
    });
  }
  saveQueue(queue);
  processNextQueueItem();
}

async function processNextQueueItem() {
  if (isProcessingQueue || activeUploadJob) {
    return;
  }

  const queue = getQueue();
  if (queue.length === 0) {
    console.log('[Vidmoly Sequential Queue] File d\'attente vide. Tous les transferts sont terminés !');
    return;
  }

  const job = queue.shift();
  saveQueue(queue);
  activeUploadJob = job;
  isProcessingQueue = true;

  console.log(`[Vidmoly Sequential Queue] >>> Démarrage du tamponnage & transfert pour ${job.seriesTitle} S${job.season}E${job.episode} (ID: ${job.episodeId}) <<<`);

  try {
    saveEpisodeEntry(job.episodeId, {
      streamSourceUrl: job.streamSourceUrl,
      status: 'downloading',
      statusMessage: 'Démarrage du téléchargement FoxBleu...',
      seriesTitle: job.seriesTitle,
      season: job.season,
      episode: job.episode,
      title: job.title
    });

    // Étape 1 : Tamponner localement le fichier via Aria2c (80-110 Mo/s)
    const ext = job.ext || 'mkv';
    await bufferEpisodeLocally(job.episodeId, ext);

    // Étape 2 : Lancer le remote upload vers Vidmoly
    saveEpisodeEntry(job.episodeId, {
      status: 'sending',
      statusMessage: "En cours d'envoi sur le serveur Vidmoly"
    });

    const res = await uploadRemoteEpisode(job);
    console.log(`[Vidmoly Sequential Queue] Ordre remote upload transmis à Vidmoly pour l'épisode ${job.episodeId}.`);

    // Sécurité : timeout de 15 minutes max par épisode pour ne jamais bloquer la file
    clearTimeout(activeUploadTimeout);
    activeUploadTimeout = setTimeout(() => {
      console.warn(`[Vidmoly Queue Timeout] Transfert de l'épisode ${job.episodeId} a dépassé 15 minutes. Nettoyage et passage au suivant.`);
      notifyExportFinished(job.episodeId);
    }, 15 * 60 * 1000);

  } catch (err) {
    console.error(`[Vidmoly Sequential Queue Error] Échec pour épisode ${job.episodeId}:`, err.message);
    saveEpisodeEntry(job.episodeId, {
      status: 'error',
      statusMessage: `Échec: ${err.message}`
    });
    activeUploadJob = null;
    isProcessingQueue = false;
    clearTimeout(activeUploadTimeout);
    // Nettoyer fichier temporaire partiel
    try {
      const f1 = path.join(BUFFER_DIR, `${job.episodeId}.mkv`);
      const f2 = path.join(BUFFER_DIR, `${job.episodeId}.mp4`);
      if (fs.existsSync(f1)) fs.unlinkSync(f1);
      if (fs.existsSync(f2)) fs.unlinkSync(f2);
    } catch (e) {}
    // Poursuivre immédiatement avec le prochain épisode de la file d'attente
    setTimeout(() => {
      processNextQueueItem();
    }, 3000);
  } finally {
    isProcessingQueue = false;
  }
}

function notifyExportFinished(episodeId) {
  console.log(`[Vidmoly Sequential Queue] Transfert SSD Local -> Vidmoly Cloud terminé pour épisode ${episodeId} !`);
  
  // 1. SUPPRESSION IMMÉDIATE DU FICHIER TAMPON LOCAL (ZÉRO LATENCE SUR DISQUE)
  try {
    const candidates = [
      path.join(BUFFER_DIR, `${episodeId}.mkv`),
      path.join(BUFFER_DIR, `${episodeId}.mp4`),
      path.join(BUFFER_DIR, `${episodeId}.mkv.aria2`),
      path.join(BUFFER_DIR, `${episodeId}.mp4.aria2`)
    ];
    for (const c of candidates) {
      if (fs.existsSync(c)) {
        fs.unlinkSync(c);
        console.log(`[Vidmoly Buffer Cleanup] Fichier tampon local libéré IMMÉDIATEMENT : ${c}`);
      }
    }
  } catch (e) {
    console.warn(`[Vidmoly Buffer Cleanup Error]`, e.message);
  }

  saveEpisodeEntry(episodeId, {
    status: 'converting',
    statusMessage: "En cours d'encodage",
    updatedAt: Date.now()
  });

  if (activeUploadJob && String(activeUploadJob.episodeId) === String(episodeId)) {
    clearTimeout(activeUploadTimeout);
    activeUploadJob = null;
    isProcessingQueue = false;

    // Démarrage rapide du prochain épisode dans la file
    setTimeout(() => {
      processNextQueueItem();
    }, 2000);
  }
}

async function uploadRemoteEpisode({ episodeId, seriesTitle, season, episode, title, streamSourceUrl }) {
  ensureStorage();
  const epId = String(episodeId);
  const apiKey = vidmolyAccounts.getActiveApiKey();

  // 1. Récupérer ou créer le dossier
  const folderId = await getOrCreateFolder(seriesTitle, season);

  // 2. Lancer le remote upload
  try {
    console.log(`[Vidmoly Remote Upload] Envoi de l'épisode ${epId} (${seriesTitle} S${season}E${episode}) vers Vidmoly (Clé API: ${apiKey.slice(0, 7)}...)...`);
    // SÉCURITÉ ABSOLUE : Vidmoly ne peut JAMAIS aspirer depuis 127.0.0.1 ou localhost
    let targetExportUrl = streamSourceUrl;
    if (!targetExportUrl || targetExportUrl.includes('127.0.0.1') || targetExportUrl.includes('localhost') || !targetExportUrl.startsWith('http')) {
      targetExportUrl = 'https://ziablo.xyz/api/stream/vidmoly-export/vmol_a02230f3bf4e479d/' + epId + '.mkv';
    }
    const cleanFileName = `${seriesTitle.replace(/[^a-zA-Z0-9]/g, '_')}_S${String(season).padStart(2, '0')}E${String(episode).padStart(2, '0')}.mp4`;
    const targetExportUrlWithBust = targetExportUrl.includes('cachebust=') ? targetExportUrl : (targetExportUrl + (targetExportUrl.includes('?') ? '&' : '?') + 'cachebust=' + Date.now());
    const uploadApiUrl = `${CONFIG.apiBase}/upload/url?key=${apiKey}&url=${encodeURIComponent(targetExportUrlWithBust)}&fld_id=${folderId}&name=${encodeURIComponent(cleanFileName)}`;
    
    const res = await fetchHttp(uploadApiUrl);
    vidmolyAccounts.incrementAccountQuota(apiKey);
    const json = JSON.parse(res.text);

    if (json.status === 200 && json.result) {
      const fileCode = json.result.file_code || json.result.filecode || json.result.id;
      const fileUrl = `https://vidmoly.org/${fileCode}.html`;
      const embedUrl = `https://vidmoly.org/embed-${fileCode}.html`;

      return saveEpisodeEntry(epId, {
        episodeId: epId,
        seriesTitle,
        season,
        episode,
        title,
        fileCode,
        fileUrl,
        embedUrl,
        folderId,
        streamSourceUrl: targetExportUrl,
        status: 'sending',
        statusMessage: "En cours d'envoi sur le serveur Vidmoly",
        updatedAt: Date.now(),
        createdAt: Date.now()
      });
    } else {
      console.warn('[Vidmoly Upload Reponse Inattendue]:', json);
      if (json.msg && (json.msg.includes('limit') || json.msg.includes('quota'))) {
        vidmolyAccounts.markAccountFull(apiKey);
      }
      return saveEpisodeEntry(epId, {
        episodeId: epId,
        seriesTitle,
        season,
        episode,
        title,
        status: 'error',
        statusMessage: json.msg || 'Erreur API Vidmoly'
      });
    }
  } catch (err) {
    console.error('[Vidmoly Upload Error]:', err.message);
    return saveEpisodeEntry(epId, {
      episodeId: epId,
      seriesTitle,
      season,
      episode,
      title,
      status: 'error',
      statusMessage: err.message
    });
  }
}

// 4. Décodeur Dean Edwards Packer
function unpackDeanEdwards(packedCode) {
  const match = packedCode.match(/eval\(function\(p,a,c,k,e,d\)\{[\s\S]*?\}\(([\s\S]*?)\)\)/);
  if (!match) return packedCode;
  try {
    const regex = new RegExp('\\}\\(\'(.*)\',\\s*(\\d+),\\s*(\\d+),\\s*\'(.*)\'\\.split\\(\'\\|\'\\),\\s*(\\d+),\\s*(\\{.*\\}|\\{\\})\\)');
    const m = packedCode.match(regex);
    if (!m) return packedCode;
    let [ , p, a, c, k ] = m;
    a = parseInt(a, 10);
    c = parseInt(c, 10);
    k = k.split('|');
    const e = (c) => (c < a ? '' : e(Math.floor(c / a))) + ((c = c % a) > 35 ? String.fromCharCode(c + 29) : c.toString(36));
    while (c--) {
      if (k[c]) {
        p = p.replace(new RegExp('\\b' + e(c) + '\\b', 'g'), k[c]);
      }
    }
    return p;
  } catch (err) {
    return packedCode;
  }
}

// 5. Stream Resolver Vidmoly (Extrait le flux .m3u8 direct - 0 QUOTA API)
async function resolveVidmolyStream(fileCode) {
  if (!fileCode) throw new Error('Code de fichier Vidmoly manquant');

  const cached = resolvedStreamsCache.get(fileCode);
  if (cached && (Date.now() - cached.timestamp < 10 * 60 * 1000)) {
    return cached.data;
  }

  const embedUrl = `https://vidmoly.org/embed-${fileCode}.html`;
  try {
    const res = await fetchHttpWarp(embedUrl, {
      'Referer': 'https://vidmoly.org/'
    });

    if (res.statusCode !== 200 || !res.text) {
      throw new Error(`Vidmoly embed HTTP ${res.statusCode}`);
    }

    let html = res.text;

    // Gestion du challenge JavaScript Vidmoly (anti-bot: window.location.replace('...?ch=1&js=...'))
    const jsChallengMatch = html.match(/window\.location\.replace\(['"]([^'"]+ch=1[^'"]+)['"]/);
    if (jsChallengMatch && jsChallengMatch[1]) {
      const challengeUrl = jsChallengMatch[1];
      console.log(`[Vidmoly JS Challenge] Détecté pour ${fileCode}, suivi: ${challengeUrl.substring(0, 80)}...`);
      try {
        const challengeRes = await fetchHttpWarp(challengeUrl, {
          'Referer': `https://vidmoly.org/embed-${fileCode}.html`,
          'Origin': 'https://vidmoly.org'
        });
        if (challengeRes.statusCode === 200 && challengeRes.text && challengeRes.text.length > 200) {
          html = challengeRes.text;
          console.log(`[Vidmoly JS Challenge] Résolu pour ${fileCode}, body length: ${html.length}`);
        } else {
          // Si le challenge redirige encore, on suit
          const challenge2Match = challengeRes.text && challengeRes.text.match(/window\.location\.replace\(['"]([^'"]+)['"]/);
          if (challenge2Match && challenge2Match[1]) {
            const res2 = await fetchHttpWarp(challenge2Match[1], { 'Referer': challengeUrl });
            if (res2.statusCode === 200 && res2.text) html = res2.text;
          }
        }
      } catch (challengeErr) {
        console.warn(`[Vidmoly JS Challenge] Erreur lors du suivi: ${challengeErr.message}`);
      }
    }

    if (html.includes('Video is converting') || html.includes('Video is being processed') || html.includes('processing')) {
      return { status: 'converting', message: "En cours d'encodage" };
    }
    if (html.includes('This video not found') || html.includes('File was deleted')) {
      return { status: 'deleted', message: 'Fichier supprimé ou introuvable' };
    }

    let directStreamUrl = null;
    const jwMatch = html.match(/sources\s*:\s*\[\s*\{\s*file\s*:\s*['"]([^'"]+)['"]/);
    if (jwMatch && jwMatch[1]) {
      directStreamUrl = jwMatch[1];
    }
    const m3u8Regex = /(https?:\/\/[^\s"'<>]+\.m3u8[^\s"'<>]*)/i;
    const mp4Regex = /(https?:\/\/[^\s"'<>]+\.mp4[^\s"'<>]*)/i;

    let m = html.match(m3u8Regex);
    if (m) {
      directStreamUrl = m[1];
    } else {
      let codeToSearch = html;
      if (html.includes('eval(function(p,a,c,k,e,d)')) {
        try { codeToSearch = unpackDeanEdwards(html); } catch (e) {}
      }
      let m2 = codeToSearch.match(m3u8Regex) || codeToSearch.match(mp4Regex);
      if (m2) directStreamUrl = m2[1];
    }

    if (!directStreamUrl) {
      console.warn(`[Vidmoly Resolver] Aucun flux direct extrait pour ${fileCode}`);
      return { status: 'pending', message: 'Flux vidéo pas encore disponible' };
    }

    const resolved = {
      status: 'ready',
      streamUrl: directStreamUrl,
      isHls: directStreamUrl.includes('.m3u8'),
      embedUrl
    };

    resolvedStreamsCache.set(fileCode, { timestamp: Date.now(), data: resolved });
    return resolved;
  } catch (err) {
    console.error(`[Vidmoly Resolver Error] ${fileCode}:`, err.message);
    throw err;
  }
}

// 6. Récupérateur & Réécriveur de Playlist HLS (.m3u8) Vidmoly
async function getVidmolyHlsPlaylist(fileCode) {
  if (!fileCode) throw new Error('Code de fichier Vidmoly manquant');

  const cached = resolvedPlaylistsCache.get(fileCode);
  if (cached && (Date.now() - cached.timestamp < 5 * 60 * 1000)) {
    return cached.data;
  }

  const resolved = await resolveVidmolyStream(fileCode);
  if (!resolved || resolved.status !== 'ready' || !resolved.streamUrl) {
    return resolved;
  }

  const masterUrl = resolved.streamUrl;
  let masterRes = await fetchHttpWarp(masterUrl);
  if (masterRes.statusCode === 403 || masterRes.statusCode === 401 || masterRes.statusCode === 410) {
    // Token expiré → invalider caches et re-résoudre
    console.log(`[Vidmoly] Token expiré pour ${fileCode} (HTTP ${masterRes.statusCode}), re-résolution...`);
    resolvedStreamsCache.delete(fileCode);
    resolvedPlaylistsCache.delete(fileCode);
    const resolved2 = await resolveVidmolyStream(fileCode);
    if (!resolved2 || resolved2.status !== 'ready' || !resolved2.streamUrl) {
      throw new Error(`Vidmoly master m3u8 HTTP ${masterRes.statusCode}`);
    }
    masterRes = await fetchHttpWarp(resolved2.streamUrl);
    if (masterRes.statusCode !== 200 || !masterRes.text) {
      throw new Error(`Vidmoly master m3u8 HTTP ${masterRes.statusCode} (après re-résolution)`);
    }
  } else if (masterRes.statusCode !== 200 || !masterRes.text) {
    throw new Error(`Vidmoly master m3u8 HTTP ${masterRes.statusCode}`);
  }

  const subLine = masterRes.text.split('\n').map(l => l.trim()).find(l => l.startsWith('http'));
  let playlistToRewrite = masterRes.text;

  if (subLine) {
    const subRes = await fetchHttpWarp(subLine);
    if (subRes.statusCode === 200 && subRes.text) {
      playlistToRewrite = subRes.text;
    }
  }

  const rewrittenPlaylist = playlistToRewrite.split('\n').map(line => {
    const trimmed = line.trim();
    if (trimmed.startsWith('http')) {
      return `/api/stream/vidmoly-segment?url=${encodeURIComponent(trimmed)}`;
    }
    return line;
  }).join('\n');

  const result = {
    status: 'ready',
    playlist: rewrittenPlaylist,
    isHls: true
  };

  resolvedPlaylistsCache.set(fileCode, { timestamp: Date.now(), data: result });
  return result;
}


function reconcileStuckEpisodes() {
  // Nettoyage automatique et agressif des fichiers tampons orphelins pour ne jamais saturer le disque
  try {
    if (fs.existsSync(BUFFER_DIR)) {
      const bFiles = fs.readdirSync(BUFFER_DIR);
      const eps = getEpisodesMap();
      const activeEpId = activeUploadJob ? String(activeUploadJob.episodeId) : null;
      const bCutoff = Date.now() - 3 * 60 * 1000; // 3 minutes max

      for (const bf of bFiles) {
        const bfp = path.join(BUFFER_DIR, bf);
        try {
          const epIdMatch = bf.match(/^(\d+)/);
          const epId = epIdMatch ? epIdMatch[1] : null;

          // RÈGLE 1 : Si l'épisode est déjà sur Vidmoly ('ready' ou 'converting'), supprimer immédiatement le tampon
          if (epId && eps[epId] && (eps[epId].status === 'ready' || eps[epId].status === 'converting')) {
            fs.rmSync(bfp, { force: true });
            console.log(`[Vidmoly Buffer Watchdog] Nettoyage immédiat (déjà sur Vidmoly) : ${bf}`);
            continue;
          }

          // RÈGLE 2 : Si le fichier est orphelin (pas le job actif) et a plus de 3 minutes -> supprimer
          const bst = fs.statSync(bfp);
          if (bst.mtimeMs < bCutoff && (!activeEpId || !bf.startsWith(activeEpId))) {
            fs.rmSync(bfp, { force: true });
            console.log(`[Vidmoly Buffer Watchdog] Nettoyage fichier tampon orphelin : ${bf}`);
          }
        } catch(e) {}
      }
    }
  } catch(e) {}

  try {
    const eps = getEpisodesMap();
    const queue = getQueue();
    const queuedIds = new Set(queue.map(q => String(q.episodeId)));
    const now = Date.now();
    let changed = false;
    let reEnqueued = 0;

    for (const [epId, ep] of Object.entries(eps)) {
      const isStuckDownloading = ep.status === 'downloading' && (!activeUploadJob || String(activeUploadJob.episodeId) !== String(epId)) && (now - (ep.updatedAt || 0) > 90 * 1000);
      const isStuckSending = ep.status === 'sending' && (!activeUploadJob || String(activeUploadJob.episodeId) !== String(epId)) && (now - (ep.updatedAt || 0) > 300 * 1000);

      if (isStuckDownloading || isStuckSending) {
        console.warn(`[Vidmoly Reconcile] Épisode orphelin détecté : ID ${epId} (${ep.title || 'Inconnu'}), statut=${ep.status}. Réintégration.`);

        if (!queuedIds.has(String(epId))) {
          // Re-queue avec l'URL source stockée (ou l'URL Xtream interne si absente)
          const reQueueSourceUrl = ep.streamSourceUrl || ep.sourceUrl ||
            (ep.streamSourceUrl && !ep.streamSourceUrl.includes('127.0.0.1') && !ep.streamSourceUrl.includes('localhost')) ? ep.streamSourceUrl : ('https://ziablo.xyz/api/stream/vidmoly-export/vmol_a02230f3bf4e479d/' + epId + '.' + (ep.ext || 'mkv'));
          queue.unshift({
            episodeId: String(epId),
            seriesTitle: ep.seriesTitle || 'Série',
            season: ep.season || 1,
            episode: ep.episode || 1,
            title: ep.title || `Épisode ${ep.episode || 1}`,
            streamSourceUrl: reQueueSourceUrl,
            queuedAt: Date.now()
          });
          queuedIds.add(String(epId));
          reEnqueued++;
        }

        ep.status = 'queued';
        ep.statusMessage = "En file d'attente (Auto-récupération)";
        ep.downloadProgress = null;
        ep.updatedAt = now;
        changed = true;
      }
    }

    if (changed) {
      fs.writeFileSync(EPISODES_FILE, JSON.stringify(eps, null, 2), 'utf8');
      saveQueue(queue);
      console.log(`[Vidmoly Reconcile] ${reEnqueued} épisode(s) orphelin(s) réintégré(s) en tête de file.`);
    }

    if (!isProcessingQueue && !activeUploadJob && queue.length > 0) {
      processNextQueueItem();
    }
  } catch (err) {
    console.error('[Vidmoly Reconcile Error]', err.message);
  }
}

// Surveillance automatique du démarrage et récurrente (toutes les 60 secondes)
setTimeout(reconcileStuckEpisodes, 3000);
setInterval(reconcileStuckEpisodes, 60000);

module.exports = {
  reconcileStuckEpisodes,
  CONFIG,
  getState,
  canMakeApiCall,
  getAccountInfo,
  getOrCreateFolder,
  getEpisodesMap,
  saveEpisodeEntry,
  getQueue,
  addToQueue,
  uploadRemoteEpisode,
  resolveVidmolyStream,
  getVidmolyHlsPlaylist,
  warpAgent,
  notifyExportFinished,
  processNextQueueItem,
  bufferEpisodeLocally
};


