// ================= TAMPON LOCAL ANTI-COUPURE =================
// Télécharge l'épisode complet sur le SSD local et vérifie sa durée intégrale avec ffprobe

function resolveFoxBleuRedirect(url) {
  return new Promise((resolve) => {
    try {
      const parsed = new URL(url);
      const client = parsed.protocol === 'https:' ? https : http;
      const isFoxBleu = url.includes('foxbleu.org') || url.includes('192.142.27.91');
      const agent = (isFoxBleu && torAgent) ? torAgent : undefined;
      const req = client.get(url, {
        agent,
        headers: {
          'User-Agent': 'VLC/3.0.18 LibVLC/3.0.18',
          'Range': 'bytes=0-100'
        },
        timeout: 10000
      }, (res) => {
        if (res.statusCode >= 300 && res.statusCode < 400 && res.headers.location) {
          const loc = res.headers.location;
          const nextUrl = loc.startsWith('http') ? loc : new URL(loc, url).href;
          resolve(nextUrl);
        } else {
          resolve(url);
        }
      });
      req.on('error', () => resolve(url));
      req.setTimeout(8000, () => { req.destroy(); resolve(url); });
    } catch {
      resolve(url);
    }
  });
}

function downloadEpisodeWithAria2(directUrl, targetFilePath) {
  const dir = path.dirname(targetFilePath);
  const fileName = path.basename(targetFilePath);
  const t0 = Date.now();

  const args = [
    '-x', '16',
    '-s', '16',
    '-k', '1M',
    '--file-allocation=none',
    '--summary-interval=2',
    '--user-agent=VLC/3.0.18 LibVLC/3.0.18',
    '--allow-overwrite=true',
    '--auto-file-renaming=false',
    '--max-connection-per-server=16',
    '--min-split-size=1M',
    '--connect-timeout=15',
    '--timeout=30',
    '--max-tries=5',
    '--retry-wait=2',
    '-d', dir,
    '-o', fileName,
    directUrl
  ];

  return new Promise((resolve, reject) => {
    const { spawn } = require('child_process');
    const child = spawn('aria2c', args);
    let lastProgressTime = Date.now();

    child.stdout.on('data', (d) => {
      lastProgressTime = Date.now();
      const str = d.toString();
      const m = str.match(/\[#\w+\s+([\d.]+\w+)\/([\d.]+\w+)\(([\d.]+)%\).*?DL:([\d.]+\w+)/);
      if (m) {
        console.log(`[Vidmoly Buffer Turbo] ${m[1]}/${m[2]} (${m[3]}%) - Vitesse: ${m[4]}/s`);
      }
    });

    const watchdog = setInterval(() => {
      if (Date.now() - lastProgressTime > 45000) {
        clearInterval(watchdog);
        try { child.kill('SIGKILL'); } catch (e) {}
        reject(new Error('Aria2c bloqué sans progression pendant 45s'));
      }
    }, 5000);

    child.on('close', (code) => {
      clearInterval(watchdog);
      const elapsed = ((Date.now() - t0) / 1000).toFixed(1);
      if (code === 0 && fs.existsSync(targetFilePath)) {
        const sizeMb = (fs.statSync(targetFilePath).size / (1024 * 1024)).toFixed(1);
        const speed = (sizeMb / elapsed).toFixed(1);
        console.log(`[Vidmoly Buffer Turbo] ✅ Téléchargement achevé : ${sizeMb} MB en ${elapsed}s (${speed} MB/s)`);
        resolve(targetFilePath);
      } else {
        reject(new Error(`Aria2c code ${code}`));
      }
    });

    child.on('error', (err) => {
      clearInterval(watchdog);
      reject(err);
    });
  });
}


function getRemoteFileSize(urlStr) {
  return new Promise((resolve) => {
    try {
      const parsed = new URL(urlStr);
      const client = parsed.protocol === 'https:' ? https : http;
      const req = client.request(urlStr, {
        method: 'GET',
        headers: { 'Range': 'bytes=0-0', 'User-Agent': 'VLC/3.0.18 LibVLC/3.0.18' },
        timeout: 8000
      }, (res) => {
        res.destroy();
        if (res.statusCode === 206 || res.statusCode === 200) {
          const cr = res.headers['content-range'];
          if (cr) {
            const m = cr.match(/\/(\d+)$/);
            if (m) return resolve(parseInt(m[1], 10));
          }
          const cl = res.headers['content-length'];
          if (cl) return resolve(parseInt(cl, 10));
        }
        resolve(0);
      });
      req.on('error', () => resolve(0));
      req.setTimeout(8000, () => { req.destroy(); resolve(0); });
      req.end();
    } catch {
      resolve(0);
    }
  });
}

async function bufferEpisodeLocally(episodeId, ext = 'mkv') {
  ensureStorage();
  const epId = String(episodeId);
  const localFile = path.join(BUFFER_DIR, `${epId}.${ext}`);
  const util = require('util');
  const execAsync = util.promisify(require('child_process').exec);

  if (!fs.existsSync(BUFFER_DIR)) fs.mkdirSync(BUFFER_DIR, { recursive: true });

  const foxbleuUrl = `http://foxbleu.org:80/series/josealbino/21321/${epId}.${ext}`;
  console.log(`[Vidmoly Buffer] Résolution du lien direct CDN pour l'épisode ${epId}...`);

  let directUrl = await resolveFoxBleuRedirect(foxbleuUrl);
  const isDirectCdn = directUrl && directUrl !== foxbleuUrl && !directUrl.includes('foxbleu.org');

  let remoteTotalBytes = 0;
  if (isDirectCdn) {
    remoteTotalBytes = await getRemoteFileSize(directUrl);
    if (remoteTotalBytes > 0) {
      console.log(`[Vidmoly Buffer] Taille attendue du fichier sur CDN : ${(remoteTotalBytes / 1024 / 1024).toFixed(1)} MB (${remoteTotalBytes} octets)`);
    }
  }

  // Si le fichier existe déjà et est 100% complet
  if (fs.existsSync(localFile)) {
    const stat = fs.statSync(localFile);
    const isComplete = remoteTotalBytes > 0 
      ? stat.size >= remoteTotalBytes * 0.995 
      : stat.size > 800 * 1024 * 1024;

    if (isComplete) {
      console.log(`[Vidmoly Buffer] Épisode ${epId} déjà complet en tampon local (${(stat.size/1024/1024).toFixed(1)} MB).`);
      return localFile;
    } else {
      console.log(`[Vidmoly Buffer] Fichier partiel détecté (${(stat.size/1024/1024).toFixed(1)} MB), reprise résiliente multi-passes...`);
    }
  }

  // Téléchargement résilient avec reprise automatique et renouvellement dynamique des jetons CDN
  let passes = 0;
  while (passes < 15) {
    passes++;
    let currentSize = fs.existsSync(localFile) ? fs.statSync(localFile).size : 0;
    if (remoteTotalBytes > 0 && currentSize >= remoteTotalBytes * 0.995) {
      break;
    }

    // Renouvellement du jeton CDN à chaque passe pour éviter l'expiration (timeout 4min)
    const freshCdnUrl = await resolveFoxBleuRedirect(foxbleuUrl);
    console.log(`[Vidmoly Buffer] Passe ${passes}/15 : ${(currentSize/1024/1024).toFixed(1)}/${(remoteTotalBytes/1024/1024).toFixed(1)} MB - Téléchargement en cours...`);

    try {
      await execAsync(`curl -s -L -A "VLC/3.0.18 LibVLC/3.0.18" --tcp-nodelay --keepalive-time 2 --max-time 180 -C - -o "${localFile}" "${freshCdnUrl}"`, { timeout: 200000 });
    } catch(e) {}
  }

  if (fs.existsSync(localFile)) {
    const finalStat = fs.statSync(localFile);
    const isComplete = remoteTotalBytes > 0 
      ? finalStat.size >= remoteTotalBytes * 0.995 
      : finalStat.size > 500 * 1024 * 1024;

    if (isComplete) {
      console.log(`[Vidmoly Buffer] ✅ Épisode ${epId} téléchargé à 100% (${(finalStat.size/1024/1024).toFixed(1)} MB) !`);
      return localFile;
    }
  }

  throw new Error(`Échec du téléchargement tampon local pour l'épisode ${epId}`);
}

// ================= GESTIONNAIRE DE FILE D'ATTENTE SÉQUENTIELLE (1 PAR 1) =================
let isProcessingQueue = false;
let activeUploadJob = null;
let activeUploadTimeout = null;

function getQueue() {
  ensureStorage();
  try {
    return JSON.parse(fs.readFileSync(QUEUE_FILE, 'utf8'));
  } catch (e) {
    return [];
  }
}

function saveQueue(queue) {
  fs.writeFileSync(QUEUE_FILE, JSON.stringify(queue, null, 2), 'utf8');
}

function addToQueue(jobs) {
  const queue = getQueue();
  const jobArray = Array.isArray(jobs) ? jobs : [jobs];
  for (const j of jobArray) {
    if (!queue.some(q => String(q.episodeId) === String(j.episodeId))) {
      queue.push({ ...j, queuedAt: Date.now() });
    }
  }
  saveQueue(queue);
  processNextQueueItem();
}

async function processNextQueueItem() {
  if (isProcessingQueue || activeUploadJob) {
    return;
  }

  const queue = getQueue();
  if (queue.length === 0) {
    console.log('[Vidmoly Sequential Queue] File d\'attente vide. Tous les transferts sont terminés !');
    return;
  }

  const job = queue.shift();
  saveQueue(queue);
  activeUploadJob = job;
  isProcessingQueue = true;

  console.log(`[Vidmoly Sequential Queue] >>> Démarrage du tamponnage & transfert pour ${job.seriesTitle} S${job.season}E${job.episode} (ID: ${job.episodeId}) <<<`);

  try {
    // Étape 1 : Tamponner localement le fichier pour garantir 100% de la durée
    const ext = job.ext || 'mkv';
    await bufferEpisodeLocally(job.episodeId, ext);

    // Étape 2 : Lancer le remote upload vers Vidmoly
    const res = await uploadRemoteEpisode(job);
    console.log(`[Vidmoly Sequential Queue] Ordre remote upload transmis à Vidmoly pour l'épisode ${job.episodeId}.`);

    // Sécurité : timeout de 15 minutes max par épisode pour ne jamais bloquer la file
    clearTimeout(activeUploadTimeout);
    activeUploadTimeout = setTimeout(() => {
      console.warn(`[Vidmoly Queue Timeout] Transfert de l'épisode ${job.episodeId} a dépassé 15 minutes. Nettoyage et passage au suivant.`);
      notifyExportFinished(job.episodeId);
    }, 15 * 60 * 1000);

  } catch (err) {
    console.error(`[Vidmoly Sequential Queue Error] Échec pour épisode ${job.episodeId}:`, err.message);
    notifyExportFinished(job.episodeId);
  } finally {
    isProcessingQueue = false;
  }
}

function notifyExportFinished(episodeId) {
  if (activeUploadJob && String(activeUploadJob.episodeId) === String(episodeId)) {
    console.log(`[Vidmoly Sequential Queue] Transfert SSD Local -> Vidmoly Cloud terminé à 100% pour épisode ${episodeId} !`);
    clearTimeout(activeUploadTimeout);
    activeUploadJob = null;
    isProcessingQueue = false;

    // Supprimer le fichier tampon local après un délai de sécurité de 30 secondes
    setTimeout(() => {
      try {
        const f1 = path.join(BUFFER_DIR, `${episodeId}.mkv`);
        const f2 = path.join(BUFFER_DIR, `${episodeId}.mp4`);
        if (fs.existsSync(f1)) fs.unlinkSync(f1);
        if (fs.existsSync(f2)) fs.unlinkSync(f2);
        console.log(`[Vidmoly Buffer Cleanup] Fichier tampon local libéré pour épisode ${episodeId}.`);
      } catch (e) {}
    }, 30000);

    // Démarrage du prochain épisode dans la file
    setTimeout(() => {
      processNextQueueItem();
    }, 5000);
  }
}

async function uploadRemoteEpisode({ episodeId, seriesTitle, season, episode, title, streamSourceUrl }) {
  ensureStorage();
  const epId = String(episodeId);
  const apiKey = vidmolyAccounts.getActiveApiKey();

  // 1. Récupérer ou créer le dossier
  const folderId = await getOrCreateFolder(seriesTitle, season);

  // 2. Lancer le remote upload
  try {
    console.log(`[Vidmoly Remote Upload] Envoi de l'épisode ${epId} (${seriesTitle} S${season}E${episode}) vers Vidmoly (Clé API: ${apiKey.slice(0, 7)}...)...`);
    const cleanFileName = `${seriesTitle.replace(/[^a-zA-Z0-9]/g, '_')}_S${String(season).padStart(2, '0')}E${String(episode).padStart(2, '0')}.mp4`;
    const streamSourceUrlWithBust = streamSourceUrl.includes('cachebust=') ? streamSourceUrl : (streamSourceUrl + (streamSourceUrl.includes('?') ? '&' : '?') + 'cachebust=' + Date.now());
    const uploadApiUrl = `${CONFIG.apiBase}/upload/url?key=${apiKey}&url=${encodeURIComponent(streamSourceUrlWithBust)}&fld_id=${folderId}&name=${encodeURIComponent(cleanFileName)}`;
    
    const res = await fetchHttp(uploadApiUrl);
    vidmolyAccounts.incrementAccountQuota(apiKey);
    const json = JSON.parse(res.text);

    if (json.status === 200 && json.result) {
      const fileCode = json.result.file_code || json.result.filecode || json.result.id;
      const fileUrl = json.result.file_url || `https://vidmoly.org/${fileCode}.html`;
      const embedUrl = `https://vidmoly.org/embed-${fileCode}.html`;

      return saveEpisodeEntry(epId, {
        episodeId: epId,
        seriesTitle,
        season,
        episode,
        title,
        fileCode,
        fileUrl,
        embedUrl,
        folderId,
        status: 'uploading',
        statusMessage: 'Téléchargement et encodage en cours sur Vidmoly',
        createdAt: Date.now()
      });
    } else {
      console.warn('[Vidmoly Upload Reponse Inattendue]:', json);
      if (json.msg && (json.msg.includes('limit') || json.msg.includes('quota'))) {
        vidmolyAccounts.markAccountFull(apiKey);
      }
      return saveEpisodeEntry(epId, {
        episodeId: epId,
        seriesTitle,
        season,
        episode,
        title,
        status: 'error',
        statusMessage: json.msg || 'Erreur API Vidmoly'
      });
    }
  } catch (err) {
    console.error('[Vidmoly Upload Error]:', err.message);
    return saveEpisodeEntry(epId, {
      episodeId: epId,
      seriesTitle,
      season,
      episode,
      title,
      status: 'error',
      statusMessage: err.message
    });
  }
}

// 4. Décodeur Dean Edwards Packer
function unpackDeanEdwards(packedCode) {
  const match = packedCode.match(/eval\(function\(p,a,c,k,e,d\)\{[\s\S]*?\}\(([\s\S]*?)\)\)/);
  if (!match) return packedCode;
  try {
    const regex = new RegExp('\\}\\(\'(.*)\',\\s*(\\d+),\\s*(\\d+),\\s*\'(.*)\'\\.split\\(\'\\|\'\\),\\s*(\\d+),\\s*(\\{.*\\}|\\{\\})\\)');
    const m = packedCode.match(regex);
    if (!m) return packedCode;
    let [ , p, a, c, k ] = m;
    a = parseInt(a, 10);
    c = parseInt(c, 10);
    k = k.split('|');
    const e = (c) => (c < a ? '' : e(Math.floor(c / a))) + ((c = c % a) > 35 ? String.fromCharCode(c + 29) : c.toString(36));
    while (c--) {
      if (k[c]) {
        p = p.replace(new RegExp('\\b' + e(c) + '\\b', 'g'), k[c]);
      }
    }
    return p;
  } catch (err) {
    return packedCode;
  }
}

// 5. Stream Resolver Vidmoly (Extrait le flux .m3u8 direct - 0 QUOTA API)
async function resolveVidmolyStream(fileCode) {
  if (!fileCode) throw new Error('Code de fichier Vidmoly manquant');

  const cached = resolvedStreamsCache.get(fileCode);
  if (cached && (Date.now() - cached.timestamp < 10 * 60 * 1000)) {
    return cached.data;
  }

  const embedUrl = `https://vidmoly.org/embed-${fileCode}.html`;
  try {
    const res = await fetchHttpWarp(embedUrl, {
      'Referer': 'https://vidmoly.org/'
    });

    if (res.statusCode !== 200 || !res.text) {
      throw new Error(`Vidmoly embed HTTP ${res.statusCode}`);
    }

    const html = res.text;

    if (html.includes('Video is converting') || html.includes('Video is being processed') || html.includes('processing')) {
      return { status: 'converting', message: 'Vidéo en cours d\'encodage chez Vidmoly' };
    }
    if (html.includes('This video not found') || html.includes('File was deleted')) {
      return { status: 'deleted', message: 'Fichier supprimé ou introuvable' };
    }

    let directStreamUrl = null;
    const jwMatch = html.match(/sources\s*:\s*\[\s*\{\s*file\s*:\s*['"]([^'"]+)['"]/);
    if (jwMatch && jwMatch[1]) {
      directStreamUrl = jwMatch[1];
    }
    const m3u8Regex = /(https?:\/\/[^\s"'<>]+\.m3u8[^\s"'<>]*)/i;
    const mp4Regex = /(https?:\/\/[^\s"'<>]+\.mp4[^\s"'<>]*)/i;

    let m = html.match(m3u8Regex);
    if (m) {
      directStreamUrl = m[1];
    } else {
      let codeToSearch = html;
      if (html.includes('eval(function(p,a,c,k,e,d)')) {
        try { codeToSearch = unpackDeanEdwards(html); } catch (e) {}
      }
      let m2 = codeToSearch.match(m3u8Regex) || codeToSearch.match(mp4Regex);
      if (m2) directStreamUrl = m2[1];
    }

    if (!directStreamUrl) {
      console.warn(`[Vidmoly Resolver] Aucun flux direct extrait pour ${fileCode}`);
      return { status: 'pending', message: 'Flux vidéo pas encore disponible' };
    }

    const resolved = {
      status: 'ready',
      streamUrl: directStreamUrl,
      isHls: directStreamUrl.includes('.m3u8'),
      embedUrl
    };

    resolvedStreamsCache.set(fileCode, { timestamp: Date.now(), data: resolved });
    return resolved;
  } catch (err) {
    console.error(`[Vidmoly Resolver Error] ${fileCode}:`, err.message);
    throw err;
  }
}

// 6. Récupérateur & Réécriveur de Playlist HLS (.m3u8) Vidmoly
async function getVidmolyHlsPlaylist(fileCode) {
  if (!fileCode) throw new Error('Code de fichier Vidmoly manquant');

  const cached = resolvedPlaylistsCache.get(fileCode);
  if (cached && (Date.now() - cached.timestamp < 5 * 60 * 1000)) {
    return cached.data;
  }

  const resolved = await resolveVidmolyStream(fileCode);
  if (!resolved || resolved.status !== 'ready' || !resolved.streamUrl) {
    return resolved;
  }

  const masterUrl = resolved.streamUrl;
  const masterRes = await fetchHttpWarp(masterUrl);
  if (masterRes.statusCode !== 200 || !masterRes.text) {
    throw new Error(`Vidmoly master m3u8 HTTP ${masterRes.statusCode}`);
  }

  const subLine = masterRes.text.split('\n').map(l => l.trim()).find(l => l.startsWith('http'));
  let playlistToRewrite = masterRes.text;

  if (subLine) {
    const subRes = await fetchHttpWarp(subLine);
    if (subRes.statusCode === 200 && subRes.text) {
      playlistToRewrite = subRes.text;
    }
  }

  const rewrittenPlaylist = playlistToRewrite.split('\n').map(line => {
    const trimmed = line.trim();
    if (trimmed.startsWith('http')) {
      return `/api/stream/vidmoly-segment?url=${encodeURIComponent(trimmed)}`;
    }
    return line;
  }).join('\n');

  const result = {
    status: 'ready',
    playlist: rewrittenPlaylist,
    isHls: true
  };

  resolvedPlaylistsCache.set(fileCode, { timestamp: Date.now(), data: result });
  return result;
}

