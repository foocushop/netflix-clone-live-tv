/**
 * XtreamProxyManager - Gestionnaire Haute Disponibilité & Auto-Guérison pour Xtream / FoxBleu
 * Fournit :
 * 1. Agent SOCKS5 résilient avec pool Cloudflare WARP
 * 2. Rotation automatique d'identité et d'IP (< 4s) en cas de blocage fournisseur
 * 3. Watchdog autonome en arrière-plan (Health-Check & Auto-Restart)
 * 4. Verrouillage anti-concurrence (Mutex) pour zéro impact utilisateur pendant les pics
 */

const { exec } = require('child_process');
const util = require('util');
const http = require('http');
const execPromise = util.promisify(exec);

let SocksProxyAgent = null;
try {
  SocksProxyAgent = require('socks-proxy-agent').SocksProxyAgent;
} catch (e) {
  try {
    SocksProxyAgent = require('/var/www/netflix-clone/node_modules/socks-proxy-agent').SocksProxyAgent;
  } catch (e2) {}
}

class XtreamProxyManager {
  constructor(options = {}) {
    this.primaryProxyUrl = options.primaryProxyUrl || process.env.XTREAM_SOCKS_URL || 'socks5h://127.0.0.1:9050';
    this.xtreamConfig = options.xtreamConfig || {
      host: 'foxbleu.org',
      port: 80,
      username: 'josealbino',
      password: '21321'
    };

    this.isRotating = false;
    this.rotationPromise = null;
    this.lastRotationTime = 0;
    this.minRotationCooldownMs = 30000; // 30 secondes minimum entre deux rotations

    this.consecutiveFailures = 0;
    this.failureThreshold = 3; // Déclenche l'auto-rotation après 3 échecs consécutifs
    this.lastHealthyCheck = Date.now();
    this.watchdogTimer = null;
    
    this.cachedAgent = this._createAgent();
  }

  _createAgent() {
    if (!SocksProxyAgent) {
      console.warn('[XtreamProxyManager] SocksProxyAgent non disponible');
      return null;
    }
    return new SocksProxyAgent(this.primaryProxyUrl, {
      keepAlive: false,
      maxSockets: 60,
      timeout: 10000
    });
  }

  getAgent() {
    return this.cachedAgent || this._createAgent();
  }

  getFreshAgent() {
    if (!SocksProxyAgent) return null;
    return new SocksProxyAgent(this.primaryProxyUrl, {
      keepAlive: false,
      timeout: 10000
    });
  }

  /**
   * Rotation d'identité WARP : génère une nouvelle clé WireGuard et une nouvelle IP de sortie
   */
  async rotateWarpIdentity(reason = 'Renouvellement circuit Tor') {
    if (this.isRotating && this.rotationPromise) {
      return this.rotationPromise;
    }

    const now = Date.now();
    if (now - this.lastRotationTime < this.minRotationCooldownMs) {
      console.log('[TorProxy] ⏳ Rotation trop récente, ignorée');
      return false;
    }

    this.isRotating = true;
    this.rotationPromise = (async () => {
      try {
        console.log(`[TorProxy] 🔄 Rotation circuit Tor : ${reason}`);
        // Send SIGNAL NEWNYM to Tor control port to get a new circuit
        try {
          const { execSync: ex } = require('child_process');
          ex('echo -e "AUTHENTICATE \"\"\nSIGNAL NEWNYM\nQUIT" | nc -w 2 127.0.0.1 9051', {
            timeout: 5000, shell: '/bin/bash', stdio: 'pipe'
          });
          console.log('[TorProxy] ✅ NEWNYM envoyé — nouveau circuit Tor obtenu');
        } catch (e) {
          // Fallback: reload tor service (slower but effective)
          try {
            const { execSync: ex } = require('child_process');
            ex('systemctl reload tor', { timeout: 8000, stdio: 'pipe' });
            console.log('[TorProxy] ✅ Tor rechargé (reload)');
          } catch (e2) {
            console.log('[TorProxy] ℹ️ NEWNYM non disponible, circuit existant maintenu');
          }
        }
        // Wait for new circuit to establish
        await new Promise(r => setTimeout(r, 2500));
        // Refresh the cached agent
        this.cachedAgent = this._createAgent();
        this.lastRotationTime = Date.now();
        this.consecutiveFailures = 0;
        console.log('[TorProxy] ✅ Rotation terminée — agent Tor rafraîchi');
        return true;
      } catch (e) {
        console.error('[TorProxy] ❌ Erreur rotation:', e.message);
        return false;
      } finally {
        this.isRotating = false;
        this.rotationPromise = null;
      }
    })();
    return this.rotationPromise;
  }

  /**
   * Vérification de santé directe vers FoxBleu via le proxy
   */
  checkHealth() {
    return new Promise((resolve) => {
      const t0 = Date.now();
      const testUrl = `http://${this.xtreamConfig.host}:${this.xtreamConfig.port}/player_api.php?username=${this.xtreamConfig.username}&password=${this.xtreamConfig.password}`;
      
      const req = http.get(testUrl, {
        agent: this.getFreshAgent(),
        headers: { 'User-Agent': 'IPTVSmartersPro/1.0', 'Accept': 'application/json' },
        timeout: 7000
      }, (res) => {
        let body = '';
        res.on('data', chunk => body += chunk);
        res.on('end', () => {
          const latency = Date.now() - t0;
          if (res.statusCode === 200 && (body.includes('"auth":1') || body.includes('user_info'))) {
            resolve({ ok: true, latencyMs: latency });
          } else {
            resolve({ ok: false, latencyMs: latency, error: `HTTP ${res.statusCode} (body: ${body.slice(0, 100)})` });
          }
        });
      });

      req.on('error', (err) => {
        resolve({ ok: false, latencyMs: Date.now() - t0, error: err.message });
      });

      req.on('timeout', () => {
        try { req.destroy(); } catch (e) {}
        resolve({ ok: false, latencyMs: Date.now() - t0, error: 'Timeout de connexion (> 7s)' });
      });
    });
  }

  /**
   * Rapporte un échec de requête sur FoxBleu pour analyse d'auto-guérison
   */
  reportFailure(reason = '') {
    this.consecutiveFailures++;
    console.warn(`[XtreamProxyManager] Signalement d'échec (${this.consecutiveFailures}/${this.failureThreshold}) : ${reason}`);
    if (this.consecutiveFailures >= this.failureThreshold) {
      console.warn(`[XtreamProxyManager] 🚨 Seuil d'échecs consécutifs atteint (${this.consecutiveFailures}). Déclenchement de l'auto-guérison immédiate...`);
      this.rotateWarpIdentity(`Seuil d'échecs consécutifs (${this.consecutiveFailures}) : ${reason}`).catch(() => {});
    }
  }

  reportSuccess() {
    if (this.consecutiveFailures > 0) {
      this.consecutiveFailures = 0;
    }
  }

  /**
   * Démarrage du Watchdog autonome (Health Check périodique)
   */
  startWatchdog(intervalSeconds = 60) {
    if (this.watchdogTimer) clearInterval(this.watchdogTimer);
    console.log(`[Xtream Watchdog] 🛡️ Démarrage du gardien automatique (contrôle toutes les ${intervalSeconds}s)...`);

    this.watchdogTimer = setInterval(async () => {
      // Ne pas tester pendant qu'une rotation est déjà en cours
      if (this.isRotating) return;

      const health = await this.checkHealth();
      if (health.ok) {
        this.lastHealthyCheck = Date.now();
        this.consecutiveFailures = 0;
      } else {
        console.warn(`[Xtream Watchdog] ⚠️ Test périodique échoué (${health.error}). Déclenchement de la rotation préventive.`);
        await this.rotateWarpIdentity(`Échec watchdog : ${health.error}`);
      }
    }, intervalSeconds * 1000);

    // Permet au process Node de ne pas rester bloqué uniquement sur ce timer s'il doit s'éteindre
    if (this.watchdogTimer.unref) {
      this.watchdogTimer.unref();
    }
  }
}

// Instance Singleton partagée
const xtreamProxyManager = new XtreamProxyManager();

module.exports = {
  XtreamProxyManager,
  xtreamProxyManager
};
